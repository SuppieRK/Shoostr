<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<module name="TreeWalker">
		<module name="MatchXpath">
			<property name="query" value="//METHOD_DEF[MODIFIERS/LITERAL_PUBLIC][TYPE/IDENT[@text='String']][PARAMETERS[not(PARAMETER)]]/SLIST/LITERAL_RETURN/EXPR/STRING_LITERAL"/>
			<message key="matchxpath.match" value="Return a string constant instead of a string literal."/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="^[ \t]*(?&lt;name&gt;[A-Za-z_$][A-Za-z0-9_$]*)[ \t]*=[ \t]*Objects\.requireNonNull\(\k&lt;name&gt;[ \t]*,[ \t]*&quot;[^&quot;]+&quot;[ \t]*\);[ \t]*$"/>
			<property name="message" value="Do not assign the unmodified result of Objects.requireNonNull."/>
			<property name="ignoreComments" value="true"/>
		</module>
	</module>
</module>
