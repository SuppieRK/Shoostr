<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="severity" value="error"/>
	<module name="TreeWalker">
		<module name="MatchXpath">
			<property name="query" value="//VARIABLE_DEF[parent::OBJBLOCK[not(parent::INTERFACE_DEF or parent::ANNOTATION_DEF)]][not(MODIFIERS/LITERAL_STATIC)][ASSIGN] | //INSTANCE_INIT"/>
			<message key="matchxpath.match" value="Initialize instance fields in a constructor, not at declaration or in an instance initializer block."/>
		</module>
		<module name="MissingJavadocType">
			<property name="scope" value="anoninner"/>
			<property name="skipAnnotations" value=""/>
		</module>
		<module name="MissingJavadocMethod">
			<property name="scope" value="anoninner"/>
			<property name="allowedAnnotations" value=""/>
		</module>
		<module name="JavadocMethod">
			<property name="accessModifiers" value="public, protected, package, private"/>
			<property name="allowedAnnotations" value=""/>
			<property name="validateThrows" value="true"/>
		</module>
		<module name="io.github.suppierk.build.StatementSpacingCheck"/>
		<module name="io.github.suppierk.build.ConstantComparisonCheck"/>
		<module name="NeedBraces">
			<property name="tokens" value="LITERAL_IF, LITERAL_ELSE"/>
			<property name="allowSingleLineStatement" value="false"/>
		</module>
		<module name="EqualsHashCode"/>
		<module name="AvoidDoubleBraceInitialization"/>
		<module name="EmptyCatchBlock">
			<property name="commentFormat" value="\w+"/>
		</module>
		<module name="FallThrough"/>
		<module name="StringLiteralEquality"/>
		<module name="EmptyStatement"/>
		<module name="RedundantImport"/>
		<module name="UnnecessaryFullyQualifiedType"/>
		<module name="AvoidStarImport"/>
		<module name="UnusedImports"/>
	</module>
</module>
