---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { Code } from '@astrojs/starlight/components';

const routeExample = appRegistrationExample();

function appRegistrationExample() {
  return `import io.github.suppierk.shoostr.Shoostr;

public class App {
  public static void main(String[] args) {
    new Shoostr()
      .routes(routes ->
        routes.get("/hello", (req, res) -> res.text("Hi!"))
      )
      .start();
  }
}`;
}
---

<div class="landing-hero">
  <DefaultHero />
  <section class="landing-code" id="first-route" aria-label="App route registration">
    <Code code={routeExample} lang="java" title="App.java (route registration)" meta="wrap" />
  </section>
</div>
