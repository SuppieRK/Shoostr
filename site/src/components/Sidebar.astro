---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';

const storagePrefix = `shoostr:sidebar:${import.meta.env.BASE_URL}:`;
---

<DefaultSidebar />

<script is:inline define:vars={{ storagePrefix }}>
  const sidebar = document.currentScript.parentElement;
  const currentPage = sidebar.querySelector('a[aria-current="page"]');
  const groups = new Map();

  for (const group of sidebar.querySelectorAll('details')) {
    const summary = group.querySelector(':scope > summary');
    if (!summary) continue;

    const key = storagePrefix + summary.textContent.trim();
    const active = group.contains(currentPage);
    groups.set(key, {group, active});

    summary.addEventListener('click', () => {
      // A summary click also represents keyboard activation and precedes the native toggle.
      const preference = group.open ? 'closed' : 'open';
      if (active) rememberActivePreference(key, preference);
      try {
        localStorage.setItem(key, preference);
      } catch {
        // A blocked write must not interrupt the toggle.
      }
    });
  }

  function rememberActivePreference(key, preference) {
    try {
      const state = history.state ?? {};
      history.replaceState({
        ...state,
        shoostrSidebar: {...state.shoostrSidebar, [key]: preference},
      }, '');
    } catch {
      // Native summary activation still works if history state cannot be written.
    }
  }

  function restorePreferences() {
    for (const [key, {group, active}] of groups) {
      // The current history entry owns explicit changes to the active group.
      if (active) {
        group.open = history.state?.shoostrSidebar?.[key] !== 'closed';
        continue;
      }
      try {
        const preference = localStorage.getItem(key);
        if (preference === 'open' || preference === 'closed') {
          group.open = preference === 'open';
        }
      } catch {
        // The native sidebar still works when browser storage is unavailable.
      }
    }
  }

  restorePreferences();
  window.addEventListener('pageshow', event => {
    if (event.persisted) restorePreferences();
  });
  window.addEventListener('popstate', restorePreferences);
</script>
