{
  "uid": "shoostr-traces",
  "title": "Shoostr traces",
  "description": "Recent greeting requests from this example. Send GET /hello/Ada to the app, then click a Trace ID to inspect its spans. This dashboard displays traces, not numeric metrics.",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Recent greeting traces (up to 20)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "jaeger",
        "uid": "shoostr-jaeger"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "shoostr-jaeger"
          },
          "queryType": "search",
          "service": "shoostr-tracing-example",
          "operation": "GET /hello/{name}",
          "limit": 20
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
