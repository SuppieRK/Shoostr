{
  "realm": "shoostr-mcp",
  "enabled": true,
  "sslRequired": "all",
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientScopes": [
    {
      "name": "mcp:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "mcp:tools",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "shoostr-mcp-resource",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "resource_url": "https://localhost:9443/mcp"
      }
    },
    {
      "clientId": "shoostr-mcp-example-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8765/callback",
        "http://localhost:6274/oauth/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [],
      "optionalClientScopes": [
        "mcp:read",
        "mcp:tools"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.signed.response.alg": "RS256",
        "access.token.header.type.rfc9068": "true"
      },
      "protocolMappers": [
        {
          "name": "mcp-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "mcp-resource-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "shoostr-mcp-resource",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "mcp-demo",
      "firstName": "MCP",
      "lastName": "Demo",
      "email": "mcp-demo@example.invalid",
      "emailVerified": true,
      "enabled": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "mcp-demo-local-only",
          "temporary": false
        }
      ]
    }
  ]
}
