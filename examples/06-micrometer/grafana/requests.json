{
  "uid": "shoostr-requests",
  "title": "Shoostr requests",
  "schemaVersion": 42,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed greetings",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shoostr-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_requests_seconds_count{route=\"/hello/{name}\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "shoostr-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Greetings / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shoostr-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{route=\"/hello/{name}\"}[1m]))",
          "legendFormat": "Greetings/second",
          "datasource": {
            "type": "prometheus",
            "uid": "shoostr-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Mean greeting latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shoostr-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_requests_seconds_sum{route=\"/hello/{name}\"}) / sum(http_server_requests_seconds_count{route=\"/hello/{name}\"})",
          "legendFormat": "Mean latency",
          "datasource": {
            "type": "prometheus",
            "uid": "shoostr-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Server errors",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shoostr-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(http_server_requests_seconds_count{status=~\"5..\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "shoostr-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Active requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "shoostr-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "http_server_requests_active_seconds_count",
          "datasource": {
            "type": "prometheus",
            "uid": "shoostr-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
